# Convex deployment variables
# Generated by `npx convex dev` or set manually
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=

# Fallback API server setting
# Used if convex token validation fails or in dev mode
CONVEX_URL=

# VPS details
# Set this to route API requests (e.g. for Vercel deployment)
VPS_API_URL=

# Note: The AGENT_SECRET is read by convex/auth.ts
# To configure it, use the secret manager: 
# npx convex env set AGENT_SECRET <your-secret>
