{
  "name": "mission-control-monorepo",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "author": "Mehdi Nabhani <mehdi@geenius.app>",
  "license": "BSL-1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/mxn2020/project-manager-mission-control.git"
  },
  "keywords": ["project-management", "dashboard", "monorepo", "convex", "react", "turborepo"],
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm run dev --workspace=apps/web",
    "stop": "lsof -ti:3000,3001,5190,5191 | xargs kill -9 2>/dev/null || true",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.8.12"
  }
}